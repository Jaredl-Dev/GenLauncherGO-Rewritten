<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:GenLauncherGO.Shared.Controls"
        xmlns:localization="using:GenLauncherGO.Shared.Localization"
        xmlns:startup="using:GenLauncherGO.Features.Startup"
        xmlns:views="using:GenLauncherGO.Features.Settings.Views"
        xmlns:vm="using:GenLauncherGO.Features.Settings"
        x:Class="GenLauncherGO.Features.Settings.Views.LauncherSettingsWindow"
        x:ClassModifier="internal"
        x:DataType="vm:LauncherSettingsViewModel"
        Title="{localization:Loc Options}"
        Width="986"
        Height="762"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource GenLauncherBackGroundImage}">
    <Window.Styles>
        <Style Selector="Border.dialog-panel.compact">
            <Setter Property="Padding" Value="16,14" />
        </Style>
        <Style Selector="TextBlock.panel-hint">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource GenLauncherInactiveBorder}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.column-header">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource GenLauncherInactiveBorder}" />
        </Style>
        <Style Selector="Image.game-cover">
            <Setter Property="Stretch" Value="UniformToFill" />
        </Style>
        <!-- Installation rows reuse the mod list's look: the managed game wears the list selection. -->
        <Style Selector="Border.folder-row">
            <Setter Property="Background" Value="{DynamicResource GenLauncherLightBackGround}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GenLauncherInactiveBorder2}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.folder-row-active">
            <Setter Property="Background" Value="{DynamicResource ListBoxSelectedItemBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GenLauncherBorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBlock.folder-name">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.folder-detail">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource GenLauncherInactiveBorder}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.folder-active">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource GenLauncherActiveColor}" />
        </Style>
        <!-- Footer links read as text, so they drop the button fill and border and only light up on hover. -->
        <Style Selector="Button.dialog-link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="Button.dialog-link:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Styles>

    <Border Classes="dialog-frame"
            Margin="31,38,31,36">
        <Grid RowDefinitions="56,*,64">
            <Border Classes="dialog-band header"
                    controls:LauncherWindowDragHandle.IsEnabled="True">
                <TextBlock Classes="dialog-title"
                           Text="{localization:Loc Options}" />
            </Border>

            <!-- Everything fits without scrolling in English; the scroll viewer only catches longer translations. -->
            <ScrollViewer Grid.Row="1"
                          Margin="20,16,8,14"
                          Padding="0,0,12,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12">
                    <Border x:Name="ActiveGameSection"
                            Classes="dialog-panel compact">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="12">
                                <Border BorderBrush="{DynamicResource GenLauncherBorderColor}"
                                        BorderThickness="1">
                                    <Image Classes="game-cover"
                                           Width="32"
                                           Height="43"
                                           Source="{Binding ActiveGame, Converter={x:Static startup:LauncherGameCovers.ForGame}}" />
                                </Border>
                                <StackPanel VerticalAlignment="Center"
                                            Spacing="2">
                                    <TextBlock Classes="section-title"
                                               Margin="0"
                                               Text="{Binding ActiveGameName}" />
                                    <TextBlock Classes="panel-hint"
                                               Text="{localization:Loc GameSettingsScopeHint}" />
                                </StackPanel>
                            </StackPanel>
                            <Grid ColumnDefinitions="250,14,*"
                                  RowDefinitions="Auto,6,Auto,6,Auto">
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Classes="column-header"
                                           Text="{localization:Loc Executables}" />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="2"
                                           Classes="column-header"
                                           Text="{localization:Loc LaunchArguments}" />
                                <Button x:Name="ManageGameClientsButton"
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Classes="dialog-action"
                                        HorizontalAlignment="Stretch"
                                        Content="{localization:Loc ManageGameClients}"
                                        Click="ManageGameClients_ClickAsync" />
                                <TextBox x:Name="GameArgumentsInput"
                                         Grid.Row="2"
                                         Grid.Column="2"
                                         Classes="dialog-input"
                                         AutomationProperties.Name="{localization:Loc GameExecutableArguments}"
                                         PlaceholderText="{localization:Loc GameExecutableArguments}"
                                         Text="{Binding GameArguments, Mode=TwoWay}"
                                         ToolTip.Tip="{localization:Loc GameExecutableArgumentsInputToolTip}" />
                                <Button x:Name="ManageWorldBuildersButton"
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Classes="dialog-action"
                                        HorizontalAlignment="Stretch"
                                        Content="{localization:Loc ManageWorldBuilders}"
                                        Click="ManageWorldBuilders_ClickAsync" />
                                <TextBox x:Name="WorldBuilderArgumentsInput"
                                         Grid.Row="4"
                                         Grid.Column="2"
                                         Classes="dialog-input"
                                         AutomationProperties.Name="{localization:Loc WorldBuilderArguments}"
                                         PlaceholderText="{localization:Loc WorldBuilderArguments}"
                                         Text="{Binding WorldBuilderArguments, Mode=TwoWay}"
                                         ToolTip.Tip="{localization:Loc WorldBuilderArgumentsInputToolTip}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="GameManagementSection"
                            Classes="dialog-panel compact">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="section-title"
                                           Margin="0"
                                           VerticalAlignment="Center"
                                           Text="{localization:Loc InstallationPaths}" />
                                <Button Grid.Column="1"
                                        Classes="dialog-action"
                                        MinHeight="30"
                                        Padding="14,3"
                                        FontSize="14"
                                        Content="{localization:Loc ChangeInstallationPaths}"
                                        Click="ManageInstallations_ClickAsync" />
                            </Grid>
                            <ItemsControl Grid.IsSharedSizeScope="True"
                                          ItemsSource="{Binding Installations.Games}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="startup:LauncherGameInstallationViewModel">
                                        <Panel Height="32">
                                            <Border Classes="folder-row" />
                                            <!-- The managed game's row lights up and is labelled as the active game. -->
                                            <Panel>
                                                <Panel.IsVisible>
                                                    <MultiBinding Converter="{x:Static views:LauncherSettingsWindow.IsActiveGame}">
                                                        <Binding Path="Game" />
                                                        <Binding Path="$parent[Window].((vm:LauncherSettingsViewModel)DataContext).ActiveGame" />
                                                    </MultiBinding>
                                                </Panel.IsVisible>
                                                <Border Classes="folder-row-active" />
                                                <TextBlock Classes="folder-active"
                                                           Margin="0,0,10,0"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Text="{localization:Loc ActiveGameLabel}" />
                                            </Panel>
                                            <!-- The name column is shared so every row's path starts at the same place. -->
                                            <Grid Margin="10,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="Auto"
                                                                      SharedSizeGroup="GameNameColumn" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <Image Grid.Column="0"
                                                       Classes="game-cover"
                                                       Width="18"
                                                       Height="24"
                                                       Source="{Binding Game, Converter={x:Static startup:LauncherGameCovers.ForGame}}" />
                                                <TextBlock Grid.Column="2"
                                                           Classes="folder-name"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding ShortName}" />
                                                <TextBlock Grid.Column="4"
                                                           Classes="folder-detail"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding Path}"
                                                           IsVisible="{Binding IsValid}"
                                                           ToolTip.Tip="{Binding Path}"
                                                           ToolTip.ToolTipOpening="PathText_ToolTipOpening" />
                                                <TextBlock Grid.Column="4"
                                                           Classes="folder-detail"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding StatusText}"
                                                           IsVisible="{Binding !IsValid}" />
                                            </Grid>
                                        </Panel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="*,14,*">
                        <Border Grid.Column="0"
                                Classes="dialog-panel compact">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="section-title"
                                           Margin="0"
                                           Text="{localization:Loc LauncherSection}" />
                                <WrapPanel ItemSpacing="18"
                                           LineSpacing="8">
                                    <TextBlock Classes="field-label"
                                               Margin="0"
                                               VerticalAlignment="Center"
                                               Text="{localization:Loc Language}" />
                                    <RadioButton Classes="square-toggle"
                                                 AutomationProperties.Name="{localization:Loc UseEnglishLanguage}"
                                                 GroupName="Language"
                                                 IsChecked="{Binding UseEnglishLanguage, Mode=TwoWay}"
                                                 ToolTip.Tip="{localization:Loc UseEnglishLanguageToolTip}">
                                        <TextBlock Text="{localization:Loc UseEnglishLanguage}"
                                                   TextWrapping="Wrap" />
                                    </RadioButton>
                                    <RadioButton Classes="square-toggle"
                                                 AutomationProperties.Name="{localization:Loc UseSystemLanguage}"
                                                 GroupName="Language"
                                                 IsChecked="{Binding UseSystemLanguage, Mode=TwoWay}"
                                                 ToolTip.Tip="{localization:Loc UseSystemLanguageToolTip}">
                                        <TextBlock Text="{localization:Loc UseSystemLanguage}"
                                                   TextWrapping="Wrap" />
                                    </RadioButton>
                                </WrapPanel>
                                <CheckBox Classes="square-toggle"
                                          AutomationProperties.Name="{localization:Loc HideLauncher}"
                                          IsChecked="{Binding HideLauncherAfterGameStart, Mode=TwoWay}"
                                          ToolTip.Tip="{localization:Loc HideLauncherToolTip}">
                                    <TextBlock Text="{localization:Loc HideLauncher}"
                                               TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox Classes="square-toggle"
                                          AutomationProperties.Name="{localization:Loc AutoDelete}"
                                          IsChecked="{Binding AutoDeleteOldVersions, Mode=TwoWay}"
                                          ToolTip.Tip="{localization:Loc AutoDeleteToolTip}">
                                    <TextBlock Text="{localization:Loc AutoDelete}"
                                               TextWrapping="Wrap" />
                                </CheckBox>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2"
                                Classes="dialog-panel compact">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="section-title"
                                           Margin="0"
                                           Text="{localization:Loc Troubleshooting}" />
                                <CheckBox x:Name="DiagnosticLoggingCheckBox"
                                          AutomationProperties.Name="{localization:Loc EnableDiagnosticLogging}"
                                          Classes="square-toggle"
                                          IsChecked="{Binding EnableDiagnosticLogging, Mode=TwoWay}"
                                          ToolTip.Tip="{localization:Loc EnableDiagnosticLoggingToolTip}">
                                    <TextBlock Text="{localization:Loc EnableDiagnosticLogging}"
                                               TextWrapping="Wrap" />
                                </CheckBox>
                                <Button Classes="dialog-action"
                                        HorizontalAlignment="Left"
                                        Command="{Binding OpenLogsDirectoryCommand}"
                                        Content="{localization:Loc OpenLogsFolder}"
                                        ToolTip.Tip="{localization:Loc OpenLogsFolderToolTip}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Classes="dialog-band footer">
                <Grid Margin="21,0"
                      ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="14">
                        <controls:VersionCopyButton Text="{Binding LauncherVersionLabel}"
                                                    CopiedText="{localization:Loc VersionCopied}"
                                                    ToolTip.Tip="{localization:Loc CopyVersionToolTip}" />
                        <Button Classes="dialog-link"
                                Command="{Binding OpenGitHubRepositoryCommand}"
                                Content="{localization:Loc GitHubRepository}"
                                ToolTip.Tip="{localization:Loc GitHubRepositoryToolTip}" />
                        <Button Classes="dialog-link"
                                Command="{Binding OpenGeneralsOnlineDiscordCommand}"
                                Content="{localization:Loc GeneralsOnlineDiscord}"
                                ToolTip.Tip="{localization:Loc GeneralsOnlineDiscordToolTip}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="dialog-action primary"
                            MinWidth="180"
                            VerticalAlignment="Center"
                            Command="{Binding CloseCommand}"
                            Content="{localization:Loc Ok}"
                            IsDefault="True" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
