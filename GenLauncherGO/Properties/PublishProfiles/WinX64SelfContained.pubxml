<?xml version="1.0" encoding="utf-8"?>
<Project>
    <PropertyGroup>
        <Configuration>Release</Configuration>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <PlatformTarget>x64</PlatformTarget>
        <Prefer32Bit>false</Prefer32Bit>
        <SelfContained>true</SelfContained>
        <!-- Native AOT compiles the application, its dependencies, the runtime and the translations into
             GenLauncherGO.exe; only the Skia, HarfBuzz and ANGLE native libraries ship beside it. Linking needs
             the MSVC toolchain (see docs/development/releasing.md). -->
        <PublishAot>true</PublishAot>
    </PropertyGroup>
</Project>
